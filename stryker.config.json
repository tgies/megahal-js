{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "reporters": [
    "html",
    "json",
    "clear-text",
    "progress",
    "dashboard"
  ],
  "testRunner": "vitest",
  "mutate": [
    "src/**/*.js",
    "!src/**/*.d.ts"
  ],
  "coverageAnalysis": "perTest",
  "thresholds": {
    "high": 90,
    "low": 80,
    "break": 75
  },
  "dashboard": {
    "project": "github.com/tgies/megahal-js",
    "reportType": "full"
  },
  "htmlReporter": {
    "fileName": "reports/mutation/mutation.html"
  }
}
